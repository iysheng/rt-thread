Import('RTT_ROOT')
Import('rtconfig')
from building import *

cwd     = os.path.join(str(Dir('#')), 'applications')
src	= Glob('main.c')
src	+= Glob('ccd_main_db.c')

CPPPATH = [cwd, str(Dir('#'))]
CPPPATH += [cwd + '/GUI']

# add can support
if GetDepend('BSP_USING_CAN_COMM'):
    src += ['can_comm.c']

# add encoder backend support
if GetDepend('BSP_USING_ENCODER'):
    src += ['encoder_thread.c']

# add screen backend support
if GetDepend('BSP_USING_ST75256'):
    src += ['screen_thread.c']
    src += Glob('GUI/UIcode.cpp')
    src += Glob('GUI/resource/*.cpp')

group = DefineGroup('Applications', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
