config BSP_USING_GPIO
    bool "Enable GPIO"
    select RT_USING_PIN
    default y

config BSP_USING_ONCHIP_FLASH
    bool "Enable Onchip FLASH"
    default n

config BSP_USING_WDT
    bool "Enable Watchdog Timer"
    select RT_USING_WDT
    default n

menuconfig BSP_USING_CAN
    bool "Enable CAN"
    select RT_USING_CAN
    default n
    if BSP_USING_CAN
    config BSP_USING_CAN0
    bool "Enable CAN0"
    default n
    config BSP_USING_CAN1
    bool "Enable CAN1"
    default n
    endif

menuconfig BSP_USING_ONCHIP_RTC
    bool "Enable RTC"
    select RT_USING_RTC
    default n
    if BSP_USING_ONCHIP_RTC
    endif
